        },
        {
          "name": "Billing history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payway/invoices",
            "description": "The payer's invoices, newest first (PAID / OVERDUE / DUE renewals)."
          },
          "response": [
            {
              "name": "200 Billing history",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/payway/invoices",
                "description": "The payer's invoices, newest first (PAID / OVERDUE / DUE renewals)."
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
