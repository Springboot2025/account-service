          ],
          "body": "{\n  \"code\": 402,\n  \"status\": \"error\",\n  \"message\": \"Payment declined: Not sufficient funds\",\n  \"data\": {\n    \"uuid\": \"d96f25db-dddf-42b7-b43e-4f221bac379a\",\n    \"orderNumber\": \"BJ261004-00000001\",\n    \"invoiceNumber\": \"INV261004-00000001\",\n    \"invoiceStatus\": \"DUE\",\n    \"periodStart\": \"2026-10-04\",\n    \"periodEnd\": \"2026-11-04\",\n    \"subscriptionUuid\": null,\n    \"subscriptionStatus\": null,\n    \"renewsAt\": null,\n    \"status\": \"DECLINED\",\n    \"planId\": 1,\n    \"planDuration\": \"monthly\",\n    \"customerNumber\": \"LAW-4\",\n    \"amount\": 20.0,\n    \"gstAmount\": 2.0,\n    \"totalAmount\": 22.0,\n    \"currency\": \"aud\",\n    \"paywayTransactionId\": 4527933815,\n    \"receiptNumber\": \"4527933815\",\n    \"responseCode\": \"51\",\n    \"responseText\": \"Not sufficient funds\",\n    \"cardScheme\": \"visa\",\n    \"maskedCardNumber\": \"456471...020\",\n    \"settlementDate\": \"2026-10-04\",\n    \"errorMessage\": null,\n    \"createdAt\": \"2026-10-03T19:51:23.656163\"\n  }\n}"
