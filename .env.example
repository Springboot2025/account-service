# Environment variables account-service reads at runtime (via System.getenv()
# or Spring ${...} placeholders). This file is a TEMPLATE ONLY -- it holds no
# real values and is safe to commit. Copy it to `.env` for your own reference
# (already gitignored) or paste the values straight into your IDE's Run/Debug
# Configuration -> Environment variables field.
#
# See LOCAL_DEV_SETUP.md for what each one is and where to find the real value.

# --- Required to start the app at all ---
JWT_SECRET=
DB_PASSWORD=
GOOGLE_API_KEY=

# --- Required for GCS file storage + Firebase (profile pictures, documents) ---
# Not read via System.getenv() -- uses Google Application Default Credentials.
# Either run `gcloud auth application-default login`, or set this instead:
GOOGLE_APPLICATION_CREDENTIALS=

# --- Required only for the "Generate Advice" AI letter feature (Claude/Anthropic) ---
# App starts fine without these; only that one endpoint fails, with a clear error.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=

# --- Stripe (use TEST mode keys locally, never live keys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
SENDGRID_API_KEY=
# Set EMAIL_PROVIDER=resend to route all email through Resend instead of
# SendGrid (unset = SendGrid, unchanged). RESEND_FROM_EMAIL must be on a
# domain verified in Resend; the default onboarding@resend.dev only delivers
# to the Resend account owner's own address.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Optional (have safe defaults) ---
PORT=8080
FRONTEND_BASE_URL=https://bossjustice.com.au
