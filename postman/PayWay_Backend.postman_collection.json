{
  "info": {
    "name": "PayWay — Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Our PayWay APIs incl. error cases, plus PayWay's own APIs for debugging. Set baseUrl, email, password, publishableKey, secretKey (sandbox only — never commit or share a collection with keys filled in). Docs: docs/payway/PAYWAY_INTEGRATION.md, CODE_WALKTHROUGH.md"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Our API — happy path",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Log in as a lawyer (individual) or firm admin. Saves accessToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('logged in', () => pm.expect(d.data.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', d.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Card token (PayWay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "https://api.payway.com.au/rest/v1/single-use-tokens",
            "description": "PayWay API, publishable key. In the app payway.js does this. Saves singleUseTokenId (single use, expires in 10 minutes) — run again before every payment.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "paymentMethod",
                  "value": "creditCard",
                  "type": "text"
                },
                {
                  "key": "cardNumber",
                  "value": "4564710000000004",
                  "type": "text"
                },
                {
                  "key": "cardholderName",
                  "value": "Test Lawyer",
                  "type": "text"
                },
                {
                  "key": "cvn",
                  "value": "847",
                  "type": "text"
                },
                {
                  "key": "expiryDateMonth",
                  "value": "02",
                  "type": "text"
                },
                {
                  "key": "expiryDateYear",
                  "value": "29",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{publishableKey}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('token created', () => pm.expect(d.singleUseTokenId).to.be.a('string'));",
                  "pm.collectionVariables.set('singleUseTokenId', d.singleUseTokenId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Make payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payway/payments",
            "description": "Creates the PayWay customer with the card (PUT /customers), charges totalAmount (POST /transactions), saves the payment; approved → invoice PAID + subscription active. Run 'Card token' first. amount must equal the plan's price for planDuration (planId 1 = $20/$200, 2 = $50/$500 in the default data).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": {{planId}},\n  \"planDuration\": \"{{planDuration}}\",\n  \"amount\": {{amount}},\n  \"gstAmount\": {{gstAmount}},\n  \"totalAmount\": {{totalAmount}},\n  \"singleUseTokenId\": \"{{singleUseTokenId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 10% GST, as the frontend does",
                  "const amount = Number(pm.collectionVariables.get('amount'));",
                  "const gst = Math.round(amount * 10) / 100;",
                  "pm.collectionVariables.set('gstAmount', gst.toFixed(2));",
                  "pm.collectionVariables.set('totalAmount', (amount + gst).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('approved', () => pm.response.to.have.status(200));",
                  "const x = pm.response.json().data || {};",
                  "if (x.customerNumber) pm.collectionVariables.set('customerNumber', x.customerNumber);",
                  "if (x.orderNumber) pm.collectionVariables.set('orderNumber', x.orderNumber);",
                  "if (x.paywayTransactionId) pm.collectionVariables.set('paywayTransactionId', String(x.paywayTransactionId));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 Approved",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/payway/payments",
                "description": "Creates the PayWay customer with the card (PUT /customers), charges totalAmount (POST /transactions), saves the payment; approved → invoice PAID + subscription active. Run 'Card token' first. amount must equal the plan's price for planDuration (planId 1 = $20/$200, 2 = $50/$500 in the default data).",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"planId\": {{planId}},\n  \"planDuration\": \"{{planDuration}}\",\n  \"amount\": {{amount}},\n  \"gstAmount\": {{gstAmount}},\n  \"totalAmount\": {{totalAmount}},\n  \"singleUseTokenId\": \"{{singleUseTokenId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 200,\n  \"status\": \"success\",\n  \"message\": \"Payment approved\",\n  \"data\": {\n    \"uuid\": \"f96515ea-7a0f-44be-9859-f4ad016b0807\",\n    \"orderNumber\": \"BJ261004-00000002\",\n    \"invoiceNumber\": \"INV261004-00000001\",\n    \"invoiceStatus\": \"PAID\",\n    \"periodStart\": \"2026-10-04\",\n    \"periodEnd\": \"2026-11-04\",\n    \"subscriptionUuid\": \"5a078ac2-70f2-4951-a594-35baf43a3a33\",\n    \"subscriptionStatus\": 1,\n    \"renewsAt\": \"2026-11-04T00:00:00\",\n    \"status\": \"APPROVED\",\n    \"planId\": 1,\n    \"planDuration\": \"monthly\",\n    \"customerNumber\": \"LAW-4\",\n    \"amount\": 20.0,\n    \"gstAmount\": 2.0,\n    \"totalAmount\": 22.0,\n    \"currency\": \"aud\",\n    \"paywayTransactionId\": 4527933816,\n    \"receiptNumber\": \"4527933816\",\n    \"responseCode\": \"08\",\n    \"responseText\": \"Honour with identification\",\n    \"cardScheme\": \"visa\",\n    \"maskedCardNumber\": \"456471...004\",\n    \"settlementDate\": \"2026-10-04\",\n    \"errorMessage\": null,\n    \"createdAt\": \"2026-10-03T19:51:25.718124\"\n  }\n}"
            },
