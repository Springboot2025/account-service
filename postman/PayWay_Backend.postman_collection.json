            }
          ]
        },
        {
          "name": "Cancel subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payway/subscription/cancel",
            "description": "Stops renewals; access continues until data.accessUntil. Body optional. 404 = never subscribed, 409 = not active.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Too expensive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 409', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        }
      ]
    },
