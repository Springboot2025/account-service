        {
          "name": "Make payment — reused token (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payway/payments",
            "description": "Sends the last token again (already used) → 422 from PayWay. If you're already subscribed you get 409 first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": {{planId}},\n  \"planDuration\": \"{{planDuration}}\",\n  \"amount\": {{amount}},\n  \"gstAmount\": {{gstAmount}},\n  \"totalAmount\": {{totalAmount}},\n  \"singleUseTokenId\": \"{{singleUseTokenId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 10% GST, as the frontend does",
                  "const amount = Number(pm.collectionVariables.get('amount'));",
                  "const gst = Math.round(amount * 10) / 100;",
                  "pm.collectionVariables.set('gstAmount', gst.toFixed(2));",
                  "pm.collectionVariables.set('totalAmount', (amount + gst).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 or 409', () => pm.expect(pm.response.code).to.be.oneOf([422, 409]));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "422 Token used/expired",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/payway/payments",
                "description": "Sends the last token again (already used) → 422 from PayWay. If you're already subscribed you get 409 first.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"planId\": {{planId}},\n  \"planDuration\": \"{{planDuration}}\",\n  \"amount\": {{amount}},\n  \"gstAmount\": {{gstAmount}},\n  \"totalAmount\": {{totalAmount}},\n  \"singleUseTokenId\": \"{{singleUseTokenId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 422,\n  \"status\": \"error\",\n  \"message\": \"Invalid single use token.  Tokens expire after 10 minutes, may only be used once and must be used by the PayWay facility under which they were created.\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
